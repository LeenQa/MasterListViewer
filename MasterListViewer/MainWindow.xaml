<Window x:Class="MasterListViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ICAO Master List Viewer" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <Button x:Name="BtnOpen" Width="160" Height="32" Content="Open .ml file..." Margin="0,0,8,0" Click="BtnOpen_Click"/>
            <Button x:Name="BtnExportCountryCounts" Width="230" Height="32" Content="Export Country Counts (Excel)" Margin="0,0,16,0" Click="BtnExportCountryCounts_Click"/>

            <CheckBox Content="Show only unexpired"
              Margin="0,0,16,0"
              IsChecked="{Binding ShowOnlyUnexpired, Mode=TwoWay}"/>

            <TextBlock Text="Total Certificates: " VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,16,0"/>
            <TextBlock Text="File:" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentFile}" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
          ItemsSource="{Binding CertificatesView}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          EnableRowVirtualization="True"
          Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                    <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="70"/>
                    <DataGridTextColumn Header="Subject CN" Binding="{Binding SubjectCN}" Width="220"/>
                    <DataGridTextColumn Header="Issuer CN" Binding="{Binding IssuerCN}" Width="220"/>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="180"/>
                    <DataGridTextColumn Header="Not Before" Binding="{Binding NotBefore}" Width="140"/>
                    <DataGridTextColumn Header="Not After" Binding="{Binding NotAfter}" Width="140"/>
                    <DataGridTextColumn Header="Algorithm" Binding="{Binding PublicKeyAlgorithm}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Country counts -->
            <GroupBox Grid.Row="1" Header="Certificates per Country" Padding="8">
                <DataGrid ItemsSource="{Binding CountryCounts}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="*"/>
                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
